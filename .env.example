APP_ENV=development
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@postgres:5432/portfolio
# Comma-separated list of allowed CORS origins.
# Add every browser origin that may call the API (no trailing slash), e.g.
# https://yourportfolio.com,https://your-user.github.io
CORS_ORIGINS=http://localhost:3000
# Public URL of the FastAPI server. This is embedded in the frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8000
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=change-me
DASHBOARD_API_KEY=
PORTFOLIO_OWNER=
PORTFOLIO_REPO=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PORTFOLIO_CONFIDENCE_THRESHOLD=0.85
AUTO_CREATE_PR=true
AUTO_MERGE=false
AUTO_UPDATE_SKILLS=true
AUTO_UPDATE_TIMELINE=true
AUTO_UPDATE_RESUME=false
AUTO_GENERATE_BLOG=false
